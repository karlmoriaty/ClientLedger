<UserControl x:Class="ClientLedger.Modules.Crm.Views.ActivitiesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:ClientLedger.Shell.Converters;assembly=ClientLedger.Shell"
             xmlns:crmConverters="clr-namespace:ClientLedger.Modules.Crm.Converters"
             xmlns:shell="clr-namespace:ClientLedger.Shell;assembly=ClientLedger.Shell">

    <UserControl.Resources>
        <converters:BoolVisibilityConverter x:Key="BoolVis" />
        <converters:AllTrueToVisibilityConverter x:Key="AllTrue" />
        <converters:InverseBoolConverter x:Key="InverseBool" />
        <converters:EmptyTextVisibilityConverter x:Key="EmptyText" />
        <crmConverters:EnumLabelConverter x:Key="EnumLabel" />
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="400" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Margin="24,18,20,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <TextBox Width="280"
                             shell:TextBoxAssist.Placeholder="搜索摘要、客户或下一步"
                             Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" />
                    <ComboBox Width="120"
                              Margin="8,0,0,0"
                              DisplayMemberPath="Label"
                              ItemsSource="{Binding KindFilters}"
                              SelectedItem="{Binding SelectedKindFilter}" />
                </StackPanel>
                <Button Grid.Column="1"
                        Command="{Binding NewActivityCommand}"
                        Content="记录跟进"
                        IsEnabled="{Binding CanWrite}"
                        Style="{StaticResource PrimaryButton}" />
            </Grid>

            <TextBlock Grid.Row="1"
                       Margin="0,10,0,0"
                       FontSize="12"
                       Foreground="{StaticResource Ink2}"
                       Text="{Binding NoticeText}"
                       Visibility="{Binding NoticeText, Converter={StaticResource EmptyText}, ConverterParameter=invert}" />

            <Border Grid.Row="2" Margin="0,10,0,0" Padding="0" Style="{StaticResource Card}">
                <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Width="132" Binding="{Binding OccurredMoment}" Header="时间" />
                        <DataGridTextColumn Width="64" Binding="{Binding KindText}" Header="方式" />
                        <DataGridTextColumn Width="140" Binding="{Binding CustomerName}" Header="客户" />
                        <DataGridTextColumn Width="*" Binding="{Binding Summary}" Header="摘要" />
                        <DataGridTextColumn Width="150" Binding="{Binding NextStep}" Header="下一步" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>

        <Border Grid.Column="1"
                Background="{StaticResource Paper1}"
                BorderBrush="{StaticResource Line}"
                BorderThickness="1,0,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Margin="18,16,14,10">
                    <TextBlock VerticalAlignment="Center"
                               Style="{StaticResource SectionTitle}"
                               Text="跟进详情"
                               Visibility="{Binding IsEditing, Converter={StaticResource BoolVis}, ConverterParameter=invert}" />
                    <TextBlock VerticalAlignment="Center"
                               Style="{StaticResource SectionTitle}"
                               Text="{Binding Editor.Heading}"
                               Visibility="{Binding IsEditing, Converter={StaticResource BoolVis}}" />

                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                        <Button Width="30"
                                Height="30"
                                Command="{Binding EditActivityCommand}"
                                Style="{StaticResource IconButton}"
                                Tag="{StaticResource Icon.Edit}"
                                ToolTip="编辑">
                            <Button.Visibility>
                                <MultiBinding Converter="{StaticResource AllTrue}">
                                    <Binding Path="HasSelection" />
                                    <Binding Converter="{StaticResource InverseBool}" Path="IsEditing" />
                                </MultiBinding>
                            </Button.Visibility>
                        </Button>
                        <Button Width="30"
                                Height="30"
                                Margin="2,0,0,0"
                                Command="{Binding DeleteCommand}"
                                Foreground="{StaticResource Danger}"
                                Style="{StaticResource IconButton}"
                                Tag="{StaticResource Icon.Trash}"
                                ToolTip="删除">
                            <Button.Visibility>
                                <MultiBinding Converter="{StaticResource AllTrue}">
                                    <Binding Path="HasSelection" />
                                    <Binding Converter="{StaticResource InverseBool}" Path="IsEditing" />
                                </MultiBinding>
                            </Button.Visibility>
                        </Button>
                    </StackPanel>
                </Grid>

                <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="18,0,18,20" Visibility="{Binding IsEditing, Converter={StaticResource BoolVis}}">

                        <TextBlock Style="{StaticResource FieldLabel}" Text="所属客户 *" />
                        <ComboBox DisplayMemberPath="Name"
                                  ItemsSource="{Binding Customers}"
                                  SelectedValue="{Binding Editor.CustomerId}"
                                  SelectedValuePath="Id" />

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="联系人" />
                                <ComboBox DisplayMemberPath="Name"
                                          ItemsSource="{Binding EditorContacts}"
                                          SelectedValue="{Binding Editor.ContactId}"
                                          SelectedValuePath="Id" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="方式" />
                                <ComboBox ItemsSource="{Binding Editor.KindOptions}" SelectedItem="{Binding Editor.Kind}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource EnumLabel}}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <TextBlock Margin="0,12,0,0" Style="{StaticResource FieldLabel}" Text="发生时间" />
                        <TextBox shell:TextBoxAssist.Placeholder="2026-11-24 14:30"
                                 Text="{Binding Editor.OccurredText, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Margin="0,12,0,0" Style="{StaticResource FieldLabel}" Text="摘要 *" />
                        <TextBox MinHeight="92"
                                 Padding="10,8"
                                 AcceptsReturn="True"
                                 shell:TextBoxAssist.Placeholder="谈了什么、对方关心什么"
                                 Text="{Binding Editor.Summary, UpdateSourceTrigger=PropertyChanged}"
                                 TextWrapping="Wrap"
                                 VerticalContentAlignment="Top" />

                        <TextBlock Margin="0,12,0,0" Style="{StaticResource FieldLabel}" Text="下一步" />
                        <TextBox shell:TextBoxAssist.Placeholder="整理阶梯报价并发给王海"
                                 Text="{Binding Editor.NextStep, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Margin="0,12,0,0" Style="{StaticResource FieldLabel}" Text="下次跟进时间（留空表示不需要）" />
                        <TextBox shell:TextBoxAssist.Placeholder="2026-11-26 10:00"
                                 Text="{Binding Editor.NextFollowText, UpdateSourceTrigger=PropertyChanged}" />

                        <StackPanel Margin="0,16,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
                            <Button MinWidth="76" Command="{Binding CancelEditCommand}" Content="取消" Style="{StaticResource SecondaryButton}" />
                            <Button MinWidth="86"
                                    Margin="8,0,0,0"
                                    Command="{Binding SaveCommand}"
                                    Content="保存"
                                    Style="{StaticResource PrimaryButton}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer Grid.Row="1"
                              HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding IsEditing, Converter={StaticResource BoolVis}, ConverterParameter=invert}">
                    <StackPanel Margin="18,0,18,20">
                        <TextBlock FontSize="12"
                                   Foreground="{StaticResource Ink3}"
                                   Text="从左侧选择一条跟进，或记录新的跟进。">
                            <TextBlock.Style>
                                <Style TargetType="{x:Type TextBlock}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasSelection}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <StackPanel Visibility="{Binding HasSelection, Converter={StaticResource BoolVis}}">
                            <StackPanel Orientation="Horizontal">
                                <Border Padding="7,2" Background="{StaticResource NeutralSoft}">
                                    <TextBlock FontSize="11"
                                               Foreground="{StaticResource Ink1}"
                                               Text="{Binding Selected.KindText}" />
                                </Border>
                                <TextBlock Margin="8,0,0,0"
                                           VerticalAlignment="Center"
                                           Style="{StaticResource Caption}"
                                           Text="{Binding Selected.OccurredMoment}" />
                            </StackPanel>

                            <TextBlock Margin="0,12,0,0"
                                       FontSize="12"
                                       Foreground="{StaticResource Ink2}"
                                       Text="{Binding Selected.CustomerName}" />

                            <TextBlock Margin="0,14,0,0"
                                       FontSize="13"
                                       LineHeight="22"
                                       Text="{Binding Selected.Summary}"
                                       TextWrapping="Wrap" />

                            <Separator Margin="0,14,0,6" />

                            <TextBlock Style="{StaticResource FieldLabel}" Text="下一步" />
                            <TextBlock FontSize="12.5"
                                       Text="{Binding Selected.NextStep}"
                                       TextWrapping="Wrap"
                                       Visibility="{Binding Selected.NextStep, Converter={StaticResource EmptyText}, ConverterParameter=invert}" />
                            <TextBlock FontSize="12.5"
                                       Foreground="{StaticResource Ink3}"
                                       Text="未填写下一步"
                                       Visibility="{Binding Selected.NextStep, Converter={StaticResource EmptyText}}" />

                            <TextBlock Margin="0,14,0,0" Style="{StaticResource FieldLabel}" Text="下次跟进" />
                            <TextBlock FontSize="12.5"
                                       Style="{StaticResource Mono}"
                                       Text="{Binding Selected.NextFollowUtc, StringFormat={}{0:yyyy-MM-dd HH:mm}}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>