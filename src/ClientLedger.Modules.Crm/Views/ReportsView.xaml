<UserControl x:Class="ClientLedger.Modules.Crm.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:ClientLedger.Shell.Converters;assembly=ClientLedger.Shell">

    <UserControl.Resources>
        <converters:PercentWidthConverter x:Key="PercentWidth" />
        <converters:MoneyTextConverter x:Key="MoneyText" />
    </UserControl.Resources>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,18,24,24">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 漏斗 -->
                <Border Grid.Column="0" Margin="0,0,7,0" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="客户漏斗" />
                        <TextBlock Margin="0,4,0,14"
                                   Style="{StaticResource Caption}"
                                   Text="当前各阶段客户数量与占比。" />

                        <ItemsControl ItemsSource="{Binding Funnel}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Height="34">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="70" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="52" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock VerticalAlignment="Center"
                                                   FontSize="12"
                                                   Foreground="{StaticResource Ink1}"
                                                   Text="{Binding Label}" />
                                        <Grid Grid.Column="1" VerticalAlignment="Center">
                                            <Border Height="14" Background="{StaticResource Paper2}" />
                                            <Border Width="{Binding Percent, Converter={StaticResource PercentWidth}, ConverterParameter=300}"
                                                    Height="14"
                                                    HorizontalAlignment="Left"
                                                    Background="{StaticResource Accent}" />
                                        </Grid>
                                        <TextBlock Grid.Column="2"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center"
                                                   FontSize="12"
                                                   Text="{Binding Count}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- 报价转化 -->
                <Border Grid.Column="1" Margin="7,0,0,0" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="报价转化" />
                        <TextBlock Margin="0,4,0,14"
                                   Style="{StaticResource Caption}"
                                   Text="已接受 / 已拒绝 / 进行中的报价分布。" />

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Style="{StaticResource Caption}" Text="报价总数" />
                                <TextBlock Margin="0,4,0,0" FontSize="24" FontWeight="SemiBold" Text="{Binding QuoteTotal}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Style="{StaticResource Caption}" Text="已接受" />
                                <TextBlock Margin="0,4,0,0"
                                           FontSize="24"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource Success}"
                                           Text="{Binding QuoteAccepted}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource Caption}" Text="赢单率" />
                                <TextBlock Margin="0,4,0,0"
                                           FontSize="24"
                                           FontWeight="SemiBold"
                                           Text="{Binding WinRateText}" />
                            </StackPanel>
                        </Grid>

                        <Border Height="1" Background="{StaticResource Line}" />

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource Caption}" Text="已接受金额" />
                                <TextBlock Margin="0,4,0,0"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Text="{Binding AcceptedAmount, Converter={StaticResource MoneyText}}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Style="{StaticResource Caption}" Text="进行中 / 已拒绝" />
                                <TextBlock Margin="0,4,0,0" FontSize="18">
                                    <Run Text="{Binding QuotePending}" />
                                    <Run Text=" / " Foreground="{StaticResource Ink3}" />
                                    <Run Text="{Binding QuoteRejected}" />
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 跟进趋势 -->
            <Border Margin="0,14,0,0" Style="{StaticResource Card}">
                <StackPanel>
                    <Grid>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="跟进活跃度" />
                        <TextBlock HorizontalAlignment="Right"
                                   Style="{StaticResource Caption}"
                                   Text="{Binding TrendSummary}" />
                    </Grid>

                    <ItemsControl Margin="0,18,0,0" ItemsSource="{Binding Trend}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Width="86">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="130" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Border Height="{Binding Percent, Converter={StaticResource PercentWidth}, ConverterParameter=120}"
                                            VerticalAlignment="Bottom"
                                            Background="{StaticResource Accent}"
                                            ToolTip="{Binding Count}" />
                                    <TextBlock Grid.Row="1"
                                               Margin="0,7,0,0"
                                               HorizontalAlignment="Center"
                                               FontSize="11.5"
                                               Text="{Binding Count}" />
                                    <TextBlock Grid.Row="2"
                                               Margin="0,2,0,0"
                                               HorizontalAlignment="Center"
                                               FontSize="10.5"
                                               Foreground="{StaticResource Ink2}"
                                               Text="{Binding Label}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- 成交趋势 -->
            <Border Margin="0,14,0,0" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="成交趋势" />
                    <TextBlock Margin="0,4,0,14"
                               Style="{StaticResource Caption}"
                               Text="按已接受报价的月份汇总，用于判断收入节奏。" />

                    <ItemsControl ItemsSource="{Binding Monthly}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Height="34">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="58" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="60" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center"
                                               FontSize="12"
                                               Foreground="{StaticResource Ink1}"
                                               Text="{Binding Label}" />
                                    <Grid Grid.Column="1" VerticalAlignment="Center">
                                        <Border Height="14" Background="{StaticResource Paper2}" />
                                        <Border Width="{Binding Percent, Converter={StaticResource PercentWidth}, ConverterParameter=620}"
                                                Height="14"
                                                HorizontalAlignment="Left"
                                                Background="{StaticResource Accent}" />
                                    </Grid>
                                    <TextBlock Grid.Column="2"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center"
                                               FontSize="12"
                                               Text="{Binding Amount, Converter={StaticResource MoneyText}}" />
                                    <TextBlock Grid.Column="3"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center"
                                               FontSize="10.5"
                                               Foreground="{StaticResource Ink3}"
                                               Text="{Binding Count, StringFormat={}{0} 份}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>