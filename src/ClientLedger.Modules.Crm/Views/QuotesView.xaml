<UserControl x:Class="ClientLedger.Modules.Crm.Views.QuotesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:ClientLedger.Shell.Converters;assembly=ClientLedger.Shell"
             xmlns:crmConverters="clr-namespace:ClientLedger.Modules.Crm.Converters"
             xmlns:shell="clr-namespace:ClientLedger.Shell;assembly=ClientLedger.Shell">

    <UserControl.Resources>
        <converters:BoolVisibilityConverter x:Key="BoolVis" />
        <converters:AllTrueToVisibilityConverter x:Key="AllTrue" />
        <converters:InverseBoolConverter x:Key="InverseBool" />
        <converters:EmptyTextVisibilityConverter x:Key="EmptyText" />
        <converters:TokenBrushConverter x:Key="TokenBrush" />
        <converters:TokenSoftBrushConverter x:Key="TokenSoft" />
        <converters:MoneyTextConverter x:Key="MoneyText" />
        <crmConverters:EnumLabelConverter x:Key="EnumLabel" />
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="470" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Margin="24,18,20,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <TextBox Width="260"
                             shell:TextBoxAssist.Placeholder="搜索单号、标题或客户"
                             Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" />
                    <ComboBox Width="124"
                              Margin="8,0,0,0"
                              DisplayMemberPath="Label"
                              ItemsSource="{Binding StatusFilters}"
                              SelectedItem="{Binding SelectedStatusFilter}" />
                </StackPanel>
                <Button Grid.Column="1"
                        Command="{Binding NewQuoteCommand}"
                        Content="新建报价"
                        IsEnabled="{Binding CanWrite}"
                        Style="{StaticResource PrimaryButton}" />
            </Grid>

            <StackPanel Grid.Row="1" Margin="0,10,0,0">
                <TextBlock FontSize="12"
                           Foreground="{StaticResource Ink2}"
                           Text="{Binding NoticeText}"
                           Visibility="{Binding NoticeText, Converter={StaticResource EmptyText}, ConverterParameter=invert}" />
                <TextBlock FontSize="11.5"
                           Foreground="{StaticResource Ink3}"
                           Text="{Binding SummaryText}" />
            </StackPanel>

            <Border Grid.Row="2" Margin="0,10,0,0" Padding="0" Style="{StaticResource Card}">
                <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Width="120" Binding="{Binding Quote.Number}" Header="单号" />
                        <DataGridTextColumn Width="140" Binding="{Binding Quote.CustomerName}" Header="客户" />
                        <DataGridTextColumn Width="*" Binding="{Binding Quote.Title}" Header="标题" />
                        <DataGridTemplateColumn Width="86" Header="状态">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border HorizontalAlignment="Left"
                                            Padding="7,2"
                                            Background="{Binding Quote.StatusToken, Converter={StaticResource TokenSoft}}">
                                        <TextBlock FontSize="11"
                                                   Foreground="{Binding Quote.StatusToken, Converter={StaticResource TokenBrush}}"
                                                   Text="{Binding Quote.StatusText}" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Width="110" Binding="{Binding TotalAmount, Converter={StaticResource MoneyText}}" Header="含税合计" />
                        <DataGridTextColumn Width="96" Binding="{Binding Quote.ValidUntilText}" Header="有效期至" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>

        <Border Grid.Column="1"
                Background="{StaticResource Paper1}"
                BorderBrush="{StaticResource Line}"
                BorderThickness="1,0,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Margin="18,16,14,10">
                    <TextBlock VerticalAlignment="Center"
                               Style="{StaticResource SectionTitle}"
                               Text="报价详情"
                               Visibility="{Binding IsEditing, Converter={StaticResource BoolVis}, ConverterParameter=invert}" />
                    <TextBlock VerticalAlignment="Center"
                               Style="{StaticResource SectionTitle}"
                               Text="{Binding Editor.Heading}"
                               Visibility="{Binding IsEditing, Converter={StaticResource BoolVis}}" />

                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                        <Button Width="30"
                                Height="30"
                                Command="{Binding EditQuoteCommand}"
                                Style="{StaticResource IconButton}"
                                Tag="{StaticResource Icon.Edit}"
                                ToolTip="编辑">
                            <Button.Visibility>
                                <MultiBinding Converter="{StaticResource AllTrue}">
                                    <Binding Path="HasSelection" />
                                    <Binding Converter="{StaticResource InverseBool}" Path="IsEditing" />
                                </MultiBinding>
                            </Button.Visibility>
                        </Button>
                        <Button Width="30"
                                Height="30"
                                Margin="2,0,0,0"
                                Command="{Binding DeleteCommand}"
                                Foreground="{StaticResource Danger}"
                                Style="{StaticResource IconButton}"
                                Tag="{StaticResource Icon.Trash}"
                                ToolTip="删除">
                            <Button.Visibility>
                                <MultiBinding Converter="{StaticResource AllTrue}">
                                    <Binding Path="HasSelection" />
                                    <Binding Converter="{StaticResource InverseBool}" Path="IsEditing" />
                                </MultiBinding>
                            </Button.Visibility>
                            <Button.IsEnabled>
                                <Binding Path="CanDelete" />
                            </Button.IsEnabled>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- 编辑 -->
                <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="18,0,18,20" Visibility="{Binding IsEditing, Converter={StaticResource BoolVis}}">

                        <TextBlock Style="{StaticResource FieldLabel}" Text="报价标题 *" />
                        <TextBox Text="{Binding Editor.Title, UpdateSourceTrigger=PropertyChanged}" />

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="客户 *" />
                                <ComboBox DisplayMemberPath="Name"
                                          ItemsSource="{Binding Customers}"
                                          SelectedValue="{Binding Editor.CustomerId}"
                                          SelectedValuePath="Id" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="状态" />
                                <ComboBox ItemsSource="{Binding Editor.StatusOptions}" SelectedItem="{Binding Editor.Status}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource EnumLabel}}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="单号" />
                                <TextBox Text="{Binding Editor.Number, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="3,0">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="整单折扣 %" />
                                <TextBox Text="{Binding Editor.DiscountPercent, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="6,0,0,0">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="税率 %" />
                                <TextBox Text="{Binding Editor.TaxPercent, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Margin="0,12,0,0" Style="{StaticResource FieldLabel}" Text="有效期至" />
                        <TextBox shell:TextBoxAssist.Placeholder="2026-12-22（可留空）"
                                 Text="{Binding Editor.ValidUntilText, UpdateSourceTrigger=PropertyChanged}" />

                        <Grid Margin="0,16,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="54" />
                                <ColumnDefinition Width="42" />
                                <ColumnDefinition Width="72" />
                                <ColumnDefinition Width="50" />
                                <ColumnDefinition Width="28" />
                            </Grid.ColumnDefinitions>
                            <TextBlock FontSize="10.5" Foreground="{StaticResource Ink2}" Text="名称" />
                            <TextBlock Grid.Column="1" FontSize="10.5" Foreground="{StaticResource Ink2}" Text="数量" />
                            <TextBlock Grid.Column="2" FontSize="10.5" Foreground="{StaticResource Ink2}" Text="单位" />
                            <TextBlock Grid.Column="3" FontSize="10.5" Foreground="{StaticResource Ink2}" Text="单价" />
                            <TextBlock Grid.Column="4" FontSize="10.5" Foreground="{StaticResource Ink2}" Text="折扣%" />
                        </Grid>

                        <ItemsControl ItemsSource="{Binding Editor.Lines}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="54" />
                                            <ColumnDefinition Width="42" />
                                            <ColumnDefinition Width="72" />
                                            <ColumnDefinition Width="50" />
                                            <ColumnDefinition Width="28" />
                                        </Grid.ColumnDefinitions>

                                        <TextBox Height="28"
                                                 MinHeight="28"
                                                 Padding="6,0"
                                                 Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBox Grid.Column="1"
                                                 Height="28"
                                                 MinHeight="28"
                                                 Padding="6,0"
                                                 Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBox Grid.Column="2"
                                                 Height="28"
                                                 MinHeight="28"
                                                 Padding="6,0"
                                                 Text="{Binding Unit, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBox Grid.Column="3"
                                                 Height="28"
                                                 MinHeight="28"
                                                 Padding="6,0"
                                                 Text="{Binding UnitPrice, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBox Grid.Column="4"
                                                 Height="28"
                                                 MinHeight="28"
                                                 Padding="6,0"
                                                 Text="{Binding DiscountPercent, UpdateSourceTrigger=PropertyChanged}" />
                                        <Button Grid.Column="5"
                                                Width="26"
                                                Height="26"
                                                HorizontalAlignment="Right"
                                                Command="{Binding DataContext.RemoveLineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Foreground="{StaticResource Danger}"
                                                Style="{StaticResource IconButton}"
                                                Tag="{StaticResource Icon.Close}"
                                                ToolTip="删除行" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Button Margin="0,4,0,0"
                                HorizontalAlignment="Left"
                                Command="{Binding AddLineCommand}"
                                Content="添加明细行"
                                Style="{StaticResource GhostButton}" />

                        <Border Margin="0,14,0,0" Padding="12" Background="{StaticResource Paper0}" BorderBrush="{StaticResource Line}" BorderThickness="1">
                            <StackPanel>
                                <Grid Height="26">
                                    <TextBlock Style="{StaticResource Caption}" Text="小计" />
                                    <TextBlock HorizontalAlignment="Right" Text="{Binding Editor.Subtotal, Converter={StaticResource MoneyText}}" />
                                </Grid>
                                <Grid Height="26">
                                    <TextBlock Style="{StaticResource Caption}" Text="整单折扣" />
                                    <TextBlock HorizontalAlignment="Right" Text="{Binding Editor.OrderDiscount, Converter={StaticResource MoneyText}}" />
                                </Grid>
                                <Grid Height="26">
                                    <TextBlock Style="{StaticResource Caption}" Text="税额" />
                                    <TextBlock HorizontalAlignment="Right" Text="{Binding Editor.Tax, Converter={StaticResource MoneyText}}" />
                                </Grid>
                                <Border Height="1" Background="{StaticResource Line}" Margin="0,4" />
                                <Grid Height="30">
                                    <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="合计" />
                                    <TextBlock HorizontalAlignment="Right"
                                               VerticalAlignment="Center"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               Text="{Binding Editor.Total, Converter={StaticResource MoneyText}}" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <StackPanel Margin="0,16,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
                            <Button MinWidth="76" Command="{Binding CancelEditCommand}" Content="取消" Style="{StaticResource SecondaryButton}" />
                            <Button MinWidth="86"
                                    Margin="8,0,0,0"
                                    Command="{Binding SaveCommand}"
                                    Content="保存"
                                    Style="{StaticResource PrimaryButton}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- 详情 -->
                <ScrollViewer Grid.Row="1"
                              HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding IsEditing, Converter={StaticResource BoolVis}, ConverterParameter=invert}">
                    <StackPanel Margin="18,0,18,20">
                        <TextBlock FontSize="12"
                                   Foreground="{StaticResource Ink3}"
                                   Text="从左侧选择一份报价，或新建报价。">
                            <TextBlock.Style>
                                <Style TargetType="{x:Type TextBlock}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasSelection}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <StackPanel Visibility="{Binding HasSelection, Converter={StaticResource BoolVis}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontSize="12"
                                           Style="{StaticResource Mono}"
                                           Foreground="{StaticResource Ink2}"
                                           Text="{Binding Selected.Quote.Number}" />
                                <Border Margin="8,0,0,0"
                                        Padding="7,2"
                                        Background="{Binding Selected.Quote.StatusToken, Converter={StaticResource TokenSoft}}">
                                    <TextBlock FontSize="11"
                                               Foreground="{Binding Selected.Quote.StatusToken, Converter={StaticResource TokenBrush}}"
                                               Text="{Binding Selected.Quote.StatusText}" />
                                </Border>
                            </StackPanel>

                            <TextBlock Margin="0,10,0,0"
                                       FontSize="17"
                                       FontWeight="SemiBold"
                                       Text="{Binding Selected.Quote.Title}"
                                       TextWrapping="Wrap" />
                            <TextBlock Margin="0,4,0,0"
                                       Style="{StaticResource Caption}"
                                       Text="{Binding Selected.Quote.CustomerName}" />

                            <TextBlock Margin="0,16,0,0"
                                       FontSize="26"
                                       FontWeight="SemiBold"
                                       Text="{Binding Selected.TotalAmount, Converter={StaticResource MoneyText}}" />
                            <TextBlock FontSize="10.5"
                                       Foreground="{StaticResource Ink3}"
                                       Text="含税合计" />

                            <Separator Margin="0,14,0,4" />
                            <TextBlock Style="{StaticResource SectionTitle}" Text="明细" />

                            <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding Selected.Lines}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Height="30">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock FontSize="12.5" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock FontSize="10.5"
                                                           Foreground="{StaticResource Ink3}"
                                                           Text="{Binding Spec}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1"
                                                       VerticalAlignment="Center"
                                                       FontSize="12"
                                                       Text="{Binding LineTotal, Converter={StaticResource MoneyText}}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Border Margin="0,12,0,0" Padding="12" Background="{StaticResource Paper0}" BorderBrush="{StaticResource Line}" BorderThickness="1">
                                <StackPanel>
                                    <Grid Height="24">
                                        <TextBlock Style="{StaticResource Caption}" Text="小计" />
                                        <TextBlock HorizontalAlignment="Right" Text="{Binding Selected.Totals.Subtotal, Converter={StaticResource MoneyText}}" />
                                    </Grid>
                                    <Grid Height="24">
                                        <TextBlock Style="{StaticResource Caption}" Text="整单折扣" />
                                        <TextBlock HorizontalAlignment="Right" Text="{Binding Selected.Totals.OrderDiscount, Converter={StaticResource MoneyText}}" />
                                    </Grid>
                                    <Grid Height="24">
                                        <TextBlock Style="{StaticResource Caption}" Text="税额" />
                                        <TextBlock HorizontalAlignment="Right" Text="{Binding Selected.Totals.Tax, Converter={StaticResource MoneyText}}" />
                                    </Grid>
                                    <Border Height="1" Background="{StaticResource Line}" Margin="0,4" />
                                    <Grid Height="28">
                                        <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="合计" />
                                        <TextBlock HorizontalAlignment="Right"
                                                   VerticalAlignment="Center"
                                                   FontWeight="SemiBold"
                                                   Text="{Binding Selected.Totals.Total, Converter={StaticResource MoneyText}}" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <TextBlock Margin="0,12,0,0"
                                       Style="{StaticResource Caption}"
                                       Text="{Binding Selected.Quote.Note}"
                                       TextWrapping="Wrap"
                                       Visibility="{Binding Selected.Quote.Note, Converter={StaticResource EmptyText}, ConverterParameter=invert}" />

                            <StackPanel Margin="0,18,0,0" Orientation="Horizontal">
                                <Button Command="{Binding MarkSentCommand}"
                                        Content="标记已发出"
                                        IsEnabled="{Binding CanWrite}"
                                        Style="{StaticResource SecondaryButton}" />
                                <Button Margin="8,0,0,0"
                                        Command="{Binding MarkAcceptedCommand}"
                                        Content="标记已接受"
                                        IsEnabled="{Binding CanWrite}"
                                        Style="{StaticResource PrimaryButton}" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>