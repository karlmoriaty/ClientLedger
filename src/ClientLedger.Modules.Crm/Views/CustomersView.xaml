<UserControl x:Class="ClientLedger.Modules.Crm.Views.CustomersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ClientLedger.Shell.Controls"
             xmlns:converters="clr-namespace:ClientLedger.Shell.Converters;assembly=ClientLedger.Shell"
             xmlns:crmConverters="clr-namespace:ClientLedger.Modules.Crm.Converters"
             xmlns:shell="clr-namespace:ClientLedger.Shell;assembly=ClientLedger.Shell">

    <UserControl.Resources>
        <converters:TokenBrushConverter x:Key="TokenBrush" />
        <converters:TokenSoftBrushConverter x:Key="TokenSoft" />
        <converters:BoolVisibilityConverter x:Key="BoolVis" />
        <converters:AllTrueToVisibilityConverter x:Key="AllTrue" />
        <converters:InverseBoolConverter x:Key="InverseBool" />
        <converters:EmptyTextVisibilityConverter x:Key="EmptyText" />
        <crmConverters:EnumLabelConverter x:Key="EnumLabel" />
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="384" />
        </Grid.ColumnDefinitions>

        <!-- ===== 列表 ===== -->
        <Grid Grid.Column="0" Margin="24,18,20,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal">
                    <TextBox Width="280"
                             shell:TextBoxAssist.Placeholder="搜索客户、行业、标签或电话"
                             Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" />
                    <ComboBox Width="128"
                              Margin="8,0,0,0"
                              DisplayMemberPath="Label"
                              ItemsSource="{Binding StatusFilters}"
                              SelectedItem="{Binding SelectedStatusFilter}" />
                </StackPanel>

                <Button Grid.Column="1"
                        Command="{Binding NewCustomerCommand}"
                        Content="新建客户"
                        IsEnabled="{Binding CanWrite}"
                        Style="{StaticResource PrimaryButton}" />
            </Grid>

            <TextBlock Grid.Row="1"
                       Margin="0,10,0,0"
                       FontSize="12"
                       Foreground="{StaticResource Ink2}"
                       Text="{Binding NoticeText}"
                       Visibility="{Binding NoticeText, Converter={StaticResource EmptyText}, ConverterParameter=invert}" />

            <Border Grid.Row="2" Margin="0,10,0,0" Padding="0" Style="{StaticResource Card}">
                <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="客户" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="26"
                                                Height="26"
                                                Background="{StaticResource AccentSoft}"
                                                BorderBrush="{StaticResource AccentLine}"
                                                BorderThickness="1">
                                            <TextBlock HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       FontSize="10.5"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource Accent}"
                                                       Text="{Binding Initials}" />
                                        </Border>
                                        <StackPanel Margin="9,0,0,0" VerticalAlignment="Center">
                                            <TextBlock FontSize="12.5"
                                                       FontWeight="SemiBold"
                                                       Text="{Binding Name}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock FontSize="10.5"
                                                       Foreground="{StaticResource Ink2}"
                                                       Text="{Binding Industry}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Width="92" Header="状态">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border HorizontalAlignment="Left"
                                            Padding="7,2"
                                            Background="{Binding StatusToken, Converter={StaticResource TokenSoft}}">
                                        <TextBlock FontSize="11"
                                                   Foreground="{Binding StatusToken, Converter={StaticResource TokenBrush}}"
                                                   Text="{Binding StatusText}" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Width="72"
                                            Binding="{Binding GradeText}"
                                            Header="等级" />
                        <DataGridTextColumn Width="96"
                                            Binding="{Binding OwnerShortName}"
                                            Header="负责人" />
                        <DataGridTextColumn Width="130"
                                            Binding="{Binding Tags}"
                                            Header="标签" />
                        <DataGridTextColumn Width="104"
                                            Binding="{Binding UpdatedText}"
                                            Header="最近更新" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>

        <!-- ===== 面板 ===== -->
        <Border Grid.Column="1"
                Background="{StaticResource Paper1}"
                BorderBrush="{StaticResource Line}"
                BorderThickness="1,0,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Margin="18,16,14,10">
                    <TextBlock VerticalAlignment="Center"
                               Style="{StaticResource SectionTitle}"
                               Text="客户详情"
                               Visibility="{Binding IsEditing, Converter={StaticResource BoolVis}, ConverterParameter=invert}" />
                    <TextBlock VerticalAlignment="Center"
                               Style="{StaticResource SectionTitle}"
                               Text="{Binding Editor.Heading}"
                               Visibility="{Binding IsEditing, Converter={StaticResource BoolVis}}" />

                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                        <Button Width="30"
                                Height="30"
                                Command="{Binding EditCustomerCommand}"
                                Style="{StaticResource IconButton}"
                                Tag="{StaticResource Icon.Edit}"
                                ToolTip="编辑">
                            <Button.Visibility>
                                <MultiBinding Converter="{StaticResource AllTrue}">
                                    <Binding Path="HasSelection" />
                                    <Binding Converter="{StaticResource InverseBool}" Path="IsEditing" />
                                </MultiBinding>
                            </Button.Visibility>
                        </Button>
                        <Button Width="30"
                                Height="30"
                                Margin="2,0,0,0"
                                Command="{Binding DeleteCommand}"
                                Foreground="{StaticResource Danger}"
                                Style="{StaticResource IconButton}"
                                Tag="{StaticResource Icon.Trash}"
                                ToolTip="删除">
                            <Button.Visibility>
                                <MultiBinding Converter="{StaticResource AllTrue}">
                                    <Binding Path="HasSelection" />
                                    <Binding Converter="{StaticResource InverseBool}" Path="IsEditing" />
                                </MultiBinding>
                            </Button.Visibility>
                            <Button.IsEnabled>
                                <Binding Path="CanDelete" />
                            </Button.IsEnabled>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- 编辑 -->
                <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="18,0,18,20"
                                Visibility="{Binding IsEditing, Converter={StaticResource BoolVis}}">

                        <TextBlock Style="{StaticResource FieldLabel}" Text="客户名称 *" />
                        <TextBox shell:TextBoxAssist.Placeholder="例如：锐丰建材有限公司"
                                 Text="{Binding Editor.Name, UpdateSourceTrigger=PropertyChanged}" />

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="行业" />
                                <TextBox Text="{Binding Editor.Industry, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="规模" />
                                <TextBox shell:TextBoxAssist.Placeholder="10-50 人"
                                         Text="{Binding Editor.Scale, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="等级" />
                                <ComboBox ItemsSource="{Binding Editor.GradeOptions}" SelectedItem="{Binding Editor.Grade}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource EnumLabel}}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="阶段" />
                                <ComboBox ItemsSource="{Binding Editor.StatusOptions}" SelectedItem="{Binding Editor.Status}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource EnumLabel}}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <TextBlock Margin="0,12,0,0" Style="{StaticResource FieldLabel}" Text="来源" />
                        <TextBox shell:TextBoxAssist.Placeholder="老客户转介绍 / 官网咨询 / 展会"
                                 Text="{Binding Editor.Source, UpdateSourceTrigger=PropertyChanged}" />

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="电话" />
                                <TextBox Text="{Binding Editor.Phone, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="邮箱" />
                                <TextBox Text="{Binding Editor.Email, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Margin="0,12,0,0" Style="{StaticResource FieldLabel}" Text="地址" />
                        <TextBox Text="{Binding Editor.Address, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Margin="0,12,0,0" Style="{StaticResource FieldLabel}" Text="标签（英文逗号分隔）" />
                        <TextBox shell:TextBoxAssist.Placeholder="年度框架,华东"
                                 Text="{Binding Editor.Tags, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Margin="0,12,0,0" Style="{StaticResource FieldLabel}" Text="备注" />
                        <TextBox MinHeight="86"
                                 Padding="10,8"
                                 AcceptsReturn="True"
                                 Text="{Binding Editor.Note, UpdateSourceTrigger=PropertyChanged}"
                                 TextWrapping="Wrap"
                                 VerticalContentAlignment="Top" />

                        <StackPanel Margin="0,16,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
                            <Button MinWidth="76" Command="{Binding CancelEditCommand}" Content="取消" Style="{StaticResource SecondaryButton}" />
                            <Button MinWidth="86"
                                    Margin="8,0,0,0"
                                    Command="{Binding SaveCommand}"
                                    Content="保存"
                                    Style="{StaticResource PrimaryButton}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- 详情 -->
                <ScrollViewer Grid.Row="1"
                              HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding IsEditing, Converter={StaticResource BoolVis}, ConverterParameter=invert}">
                    <StackPanel Margin="18,0,18,20">

                        <TextBlock FontSize="12"
                                   Foreground="{StaticResource Ink3}"
                                   Text="从左侧选择一位客户，或新建客户。">
                            <TextBlock.Style>
                                <Style TargetType="{x:Type TextBlock}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasSelection}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <StackPanel Visibility="{Binding HasSelection, Converter={StaticResource BoolVis}}">
                            <TextBlock FontSize="18"
                                       FontWeight="SemiBold"
                                       Text="{Binding Selected.Name}"
                                       TextWrapping="Wrap" />

                            <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                                <Border Padding="7,2" Background="{Binding Selected.StatusToken, Converter={StaticResource TokenSoft}}">
                                    <TextBlock FontSize="11"
                                               Foreground="{Binding Selected.StatusToken, Converter={StaticResource TokenBrush}}"
                                               Text="{Binding Selected.StatusText}" />
                                </Border>
                                <Border Margin="6,0,0,0" Padding="7,2" Background="{Binding Selected.GradeToken, Converter={StaticResource TokenSoft}}">
                                    <TextBlock FontSize="11"
                                               Foreground="{Binding Selected.GradeToken, Converter={StaticResource TokenBrush}}"
                                               Text="{Binding Selected.GradeText}" />
                                </Border>
                            </StackPanel>

                            <Grid Margin="0,16,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="78" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="26" />
                                    <RowDefinition Height="26" />
                                    <RowDefinition Height="26" />
                                    <RowDefinition Height="26" />
                                    <RowDefinition Height="26" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Style="{StaticResource Caption}" Text="行业" />
                                <TextBlock Grid.Column="1" Text="{Binding Selected.Industry}" TextTrimming="CharacterEllipsis" />

                                <TextBlock Grid.Row="1" Style="{StaticResource Caption}" Text="规模" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Selected.Scale}" />

                                <TextBlock Grid.Row="2" Style="{StaticResource Caption}" Text="来源" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Selected.Source}" />

                                <TextBlock Grid.Row="3" Style="{StaticResource Caption}" Text="电话" />
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Selected.Phone}" />

                                <TextBlock Grid.Row="4" Style="{StaticResource Caption}" Text="地址" />
                                <TextBlock Grid.Row="4"
                                           Grid.Column="1"
                                           Text="{Binding Selected.Address}"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding Selected.Address}" />

                                <TextBlock Grid.Row="5" Margin="0,4,0,0" Style="{StaticResource Caption}" Text="标签" />
                                <TextBlock Grid.Row="5"
                                           Grid.Column="1"
                                           Margin="0,4,0,0"
                                           Text="{Binding Selected.Tags}"
                                           TextWrapping="Wrap" />
                            </Grid>

                            <TextBlock Margin="0,10,0,0"
                                       FontSize="12"
                                       Foreground="{StaticResource Ink2}"
                                       Text="{Binding Selected.Note}"
                                       TextWrapping="Wrap"
                                       Visibility="{Binding Selected.Note, Converter={StaticResource EmptyText}, ConverterParameter=invert}" />

                            <Separator Margin="0,14,0,4" />

                            <TextBlock Style="{StaticResource SectionTitle}" Text="联系人" />

                            <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding Contacts}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Height="34">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock FontSize="12.5" Text="{Binding Name}" />
                                                <TextBlock Margin="6,0,0,0"
                                                           FontSize="10.5"
                                                           Foreground="{StaticResource Ink2}"
                                                           Text="{Binding Title}" />
                                                <Border Margin="6,0,0,0"
                                                        Padding="5,1"
                                                        Background="{StaticResource AccentSoft}"
                                                        Visibility="{Binding IsPrimary, Converter={StaticResource BoolVis}}">
                                                    <TextBlock FontSize="9.5"
                                                               Foreground="{StaticResource Accent}"
                                                               Text="主" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1"
                                                       VerticalAlignment="Center"
                                                       FontSize="11"
                                                       Foreground="{StaticResource Ink2}"
                                                       Text="{Binding Phone}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Separator Margin="0,12,0,4" />

                            <TextBlock Style="{StaticResource SectionTitle}" Text="跟进时间线" />

                            <ItemsControl Margin="0,10,0,0" ItemsSource="{Binding Timeline}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="3" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Margin="0,4,0,4" Background="{StaticResource AccentLine}" />
                                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock FontSize="10.5"
                                                               Foreground="{StaticResource Ink2}"
                                                               Text="{Binding KindText}" />
                                                    <TextBlock Margin="8,0,0,0"
                                                               FontSize="10.5"
                                                               Foreground="{StaticResource Ink3}"
                                                               Text="{Binding OccurredMoment}" />
                                                </StackPanel>
                                                <TextBlock Margin="0,3,0,0"
                                                           FontSize="12.5"
                                                           Text="{Binding Summary}"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Margin="0,2,0,0"
                                                           FontSize="11"
                                                           Foreground="{StaticResource Ink2}"
                                                           Text="{Binding NextStep, StringFormat=下一步：{0}}"
                                                           Visibility="{Binding NextStep, Converter={StaticResource EmptyText}, ConverterParameter=invert}" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox shell:TextBoxAssist.Placeholder="记一句刚才的沟通…"
                                         Text="{Binding QuickFollowUpText, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Grid.Column="1"
                                        MinWidth="62"
                                        Margin="8,0,0,0"
                                        Command="{Binding QuickFollowUpCommand}"
                                        Content="记录"
                                        IsEnabled="{Binding CanFollowUp}"
                                        Style="{StaticResource SecondaryButton}" />
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>