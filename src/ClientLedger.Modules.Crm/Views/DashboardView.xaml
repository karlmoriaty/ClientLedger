<UserControl x:Class="ClientLedger.Modules.Crm.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:ClientLedger.Shell.Converters;assembly=ClientLedger.Shell">

    <UserControl.Resources>
        <converters:TokenBrushConverter x:Key="TokenBrush" />
        <converters:TokenSoftBrushConverter x:Key="TokenSoft" />
        <converters:PercentWidthConverter x:Key="PercentWidth" />
    </UserControl.Resources>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,18,24,24">

            <StackPanel Orientation="Horizontal">
                <Border Width="3"
                        Height="34"
                        Margin="0,0,12,0"
                        Background="{StaticResource Accent}" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource Caption}" Text="{Binding TodayText}" />
                    <TextBlock Margin="0,2,0,0"
                               FontSize="19"
                               FontWeight="SemiBold"
                               Text="{Binding GreetingText}" />
                </StackPanel>
            </StackPanel>

            <!-- KPI -->
            <Grid Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Margin="0,0,6,0" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Caption}" Text="客户总数" />
                        <TextBlock Margin="0,6,0,0"
                                   FontSize="27"
                                   FontWeight="SemiBold"
                                   Text="{Binding TotalCustomers}" />
                        <TextBlock Margin="0,2,0,0"
                                   FontSize="10.5"
                                   Foreground="{StaticResource Ink3}"
                                   Text="全部在册客户" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Margin="6,0" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Caption}" Text="本月新增" />
                        <TextBlock Margin="0,6,0,0"
                                   FontSize="27"
                                   FontWeight="SemiBold"
                                   Text="{Binding NewThisMonth}" />
                        <TextBlock Margin="0,2,0,0"
                                   FontSize="10.5"
                                   Foreground="{StaticResource Ink3}"
                                   Text="按创建时间统计" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Margin="6,0" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Caption}" Text="待跟进" />
                        <TextBlock Margin="0,6,0,0"
                                   FontSize="27"
                                   FontWeight="SemiBold"
                                   Text="{Binding PendingFollowUps}" />
                        <TextBlock Margin="0,2,0,0"
                                   FontSize="10.5"
                                   Foreground="{StaticResource Ink3}"
                                   Text="三天内到期" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="3" Margin="6,0,0,0" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Caption}" Text="本月成交" />
                        <TextBlock Margin="0,6,0,0"
                                   FontSize="27"
                                   FontWeight="SemiBold"
                                   Text="{Binding WonThisMonth}" />
                        <TextBlock Margin="0,2,0,0"
                                   FontSize="10.5"
                                   Foreground="{StaticResource Ink3}"
                                   Text="状态变为已成交" />
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="370" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,14,0">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid>
                                <TextBlock Style="{StaticResource SectionTitle}" Text="今日日程" />
                                <TextBlock HorizontalAlignment="Right"
                                           Style="{StaticResource Caption}"
                                           Text="{Binding TodaySchedules.Count, StringFormat={}{0} 项}" />
                            </Grid>

                            <ItemsControl Margin="0,10,0,0" ItemsSource="{Binding TodaySchedules}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Height="40">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="72" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock VerticalAlignment="Center"
                                                       FontSize="12"
                                                       Foreground="{StaticResource Ink2}"
                                                       Text="{Binding TimeRange}" />
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock FontSize="12.5" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock FontSize="10.5"
                                                           Foreground="{StaticResource Ink3}"
                                                           Text="{Binding CustomerName}" />
                                            </StackPanel>
                                            <Border Grid.Column="2"
                                                    Style="{StaticResource Badge}"
                                                    Background="{Binding StateToken, Converter={StaticResource TokenSoft}}">
                                                <TextBlock FontSize="10.5"
                                                           Foreground="{Binding StateToken, Converter={StaticResource TokenBrush}}"
                                                           Text="{Binding KindText}" />
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Margin="0,6,0,2"
                                       FontSize="12"
                                       Foreground="{StaticResource Ink3}"
                                       Text="{Binding ScheduleEmptyText}">
                                <TextBlock.Style>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasSchedules}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <Border Margin="0,12,0,0" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="最近跟进" />

                            <ItemsControl Margin="0,10,0,0" ItemsSource="{Binding RecentActivities}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Height="44">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="84" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock VerticalAlignment="Center"
                                                       FontSize="11.5"
                                                       Foreground="{StaticResource Ink2}"
                                                       Text="{Binding OccurredDay}" />
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock FontSize="12.5"
                                                           Text="{Binding Summary}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock FontSize="10.5"
                                                           Foreground="{StaticResource Ink3}"
                                                           Text="{Binding CustomerName}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2"
                                                       VerticalAlignment="Center"
                                                       FontSize="10.5"
                                                       Foreground="{StaticResource Ink2}"
                                                       Text="{Binding KindText}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Margin="0,6,0,2"
                                       FontSize="12"
                                       Foreground="{StaticResource Ink3}"
                                       Text="还没有跟进记录，去「跟进」页记录第一条。">
                                <TextBlock.Style>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasActivities}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <Border Grid.Column="1" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="客户状态分布" />
                        <TextBlock Margin="0,4,0,10"
                                   Style="{StaticResource Caption}"
                                   Text="按当前阶段统计，用于判断漏斗是否健康。" />

                        <ItemsControl ItemsSource="{Binding Funnel}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Height="32">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="66" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="42" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock VerticalAlignment="Center"
                                                   FontSize="11.5"
                                                   Foreground="{StaticResource Ink1}"
                                                   Text="{Binding Label}" />
                                        <Grid Grid.Column="1" VerticalAlignment="Center">
                                            <Border Height="12" Background="{StaticResource Paper2}" />
                                            <Border Width="{Binding Percent, Converter={StaticResource PercentWidth}, ConverterParameter=210}"
                                                    Height="12"
                                                    HorizontalAlignment="Left"
                                                    Background="{StaticResource Accent}" />
                                        </Grid>
                                        <TextBlock Grid.Column="2"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center"
                                                   FontSize="11.5"
                                                   Text="{Binding Count}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>