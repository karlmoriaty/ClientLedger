<controls:ChromeWindow x:Class="ClientLedger.Shell.Views.ShellWindow"
                       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                       xmlns:controls="clr-namespace:ClientLedger.Shell.Controls"
                       xmlns:converters="clr-namespace:ClientLedger.Shell.Converters"
                       Title="ClientLedger"
                       Width="1440"
                       Height="900"
                       MinWidth="1180"
                       MinHeight="720"
                       Style="{StaticResource ChromeWindowStyle}"
                       WindowStartupLocation="CenterScreen">

    <controls:ChromeWindow.InputBindings>
        <KeyBinding Key="K" Command="{Binding OpenPaletteCommand}" Modifiers="Control" />
        <KeyBinding Key="R" Command="{Binding RefreshCommand}" Modifiers="Control" />
        <KeyBinding Key="OemComma" Command="{Binding OpenSettingsCommand}" Modifiers="Control" />
    </controls:ChromeWindow.InputBindings>

    <controls:ChromeWindow.Resources>
        <converters:TokenBrushConverter x:Key="TokenBrush" />
        <converters:TokenSoftBrushConverter x:Key="TokenSoft" />
    </controls:ChromeWindow.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="216" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ===== 侧栏 ===== -->
        <Border Grid.Column="0"
                Background="{StaticResource Paper1}"
                BorderBrush="{StaticResource Line}"
                BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Margin="18,20,18,16">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="28"
                                Height="28"
                                Background="{StaticResource Accent}">
                            <controls:Icon HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource InkOnAccent}"
                                           Geometry="{StaticResource Icon.AppMark}"
                                           Size="15"
                                           StrokeThickness="2.2" />
                        </Border>
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock FontSize="13.5"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource Ink0}"
                                       Text="ClientLedger" />
                            <TextBlock Margin="0,1,0,0"
                                       FontSize="10.5"
                                       Foreground="{StaticResource Ink2}"
                                       Text="客户台账 · 本地版" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <ListBox Grid.Row="1"
                         Margin="0,2,0,0"
                         ItemsSource="{Binding Entries}"
                         ItemContainerStyle="{StaticResource NavItem}"
                         SelectedItem="{Binding SelectedEntry, Mode=TwoWay}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <controls:Icon VerticalAlignment="Center"
                                               Geometry="{Binding Icon}"
                                               Size="17"
                                               StrokeThickness="1.85" />
                                <TextBlock Margin="10,0,0,0"
                                           VerticalAlignment="Center"
                                           FontSize="13"
                                           Text="{Binding Title}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel Grid.Row="2" Margin="8,0,8,12">
                    <Button Height="34"
                            Padding="10,0"
                            HorizontalContentAlignment="Left"
                            Command="{Binding OpenSettingsCommand}"
                            Style="{StaticResource GhostButton}">
                        <StackPanel Orientation="Horizontal">
                            <controls:Icon VerticalAlignment="Center"
                                           Geometry="{StaticResource Icon.Sliders}"
                                           Size="16"
                                           StrokeThickness="1.8" />
                            <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" Text="设置" />
                        </StackPanel>
                    </Button>

                    <Border Margin="2,8,2,0"
                            Padding="10,9"
                            Background="{StaticResource Paper0}"
                            BorderBrush="{StaticResource Line}"
                            BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Width="26"
                                    Height="26"
                                    Background="{StaticResource AccentSoft}"
                                    BorderBrush="{StaticResource AccentLine}"
                                    BorderThickness="1">
                                <TextBlock HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource Accent}"
                                           Text="{Binding UserInitial}" />
                            </Border>

                            <StackPanel Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center">
                                <TextBlock FontSize="12"
                                           FontWeight="SemiBold"
                                           Text="{Binding UserName}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Margin="0,1,0,0"
                                           FontSize="10.5"
                                           Foreground="{StaticResource Ink2}"
                                           Text="{Binding RoleText}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <TextBlock Margin="4,8,0,0"
                               FontSize="10"
                               Foreground="{StaticResource Ink3}"
                               Text="{Binding VersionText}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== 主区 ===== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="56" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{StaticResource Paper0}"
                    BorderBrush="{StaticResource Line}"
                    BorderThickness="0,0,0,1">
                <Grid Margin="24,0,22,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                        <TextBlock FontSize="17"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource Ink0}"
                                   Text="{Binding PageTitle}" />
                        <TextBlock Margin="12,1,0,0"
                                   VerticalAlignment="Center"
                                   FontSize="12"
                                   Foreground="{StaticResource Ink2}"
                                   Text="{Binding PageSubtitle}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">

                        <Border Margin="0,0,12,0"
                                Padding="8,3"
                                Background="{Binding LicenseTone, Converter={StaticResource TokenSoft}}"
                                ToolTip="{Binding LicenseMessage}">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="6"
                                        Height="6"
                                        VerticalAlignment="Center"
                                        Background="{Binding LicenseTone, Converter={StaticResource TokenBrush}}" />
                                <TextBlock Margin="6,0,0,0"
                                           FontSize="11"
                                           Foreground="{Binding LicenseTone, Converter={StaticResource TokenBrush}}"
                                           Text="{Binding LicenseText}" />
                            </StackPanel>
                        </Border>

                        <Button Height="30"
                                Padding="10,0"
                                Command="{Binding OpenPaletteCommand}"
                                Style="{StaticResource QuietButton}"
                                ToolTip="搜索或跳转（Ctrl+K）">
                            <StackPanel Orientation="Horizontal">
                                <controls:Icon VerticalAlignment="Center"
                                               Foreground="{StaticResource Ink2}"
                                               Geometry="{StaticResource Icon.Search}"
                                               Size="14"
                                               StrokeThickness="1.9" />
                                <TextBlock Margin="7,0,16,0"
                                           VerticalAlignment="Center"
                                           FontSize="12"
                                           Foreground="{StaticResource Ink2}"
                                           Text="搜索或跳转" />
                                <Border Padding="5,1"
                                        Background="{StaticResource Paper0}"
                                        BorderBrush="{StaticResource Line}"
                                        BorderThickness="1">
                                    <TextBlock FontSize="10"
                                               Foreground="{StaticResource Ink2}"
                                               Text="Ctrl K" />
                                </Border>
                            </StackPanel>
                        </Button>

                        <Button Width="30"
                                Height="30"
                                Margin="6,0,0,0"
                                Command="{Binding RefreshCommand}"
                                Style="{StaticResource IconButton}"
                                Tag="{StaticResource Icon.Refresh}"
                                ToolTip="刷新（Ctrl+R）" />
                    </StackPanel>
                </Grid>
            </Border>

            <ContentControl Grid.Row="1" Content="{Binding CurrentPage}" />
        </Grid>
    </Grid>
</controls:ChromeWindow>