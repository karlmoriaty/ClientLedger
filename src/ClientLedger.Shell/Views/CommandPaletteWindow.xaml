<controls:ChromeWindow x:Class="ClientLedger.Shell.Views.CommandPaletteWindow"
                       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                       xmlns:controls="clr-namespace:ClientLedger.Shell.Controls"
                       xmlns:shell="clr-namespace:ClientLedger.Shell"
                       Title="快速跳转"
                       Width="560"
                       Height="396"
                       ResizeMode="NoResize"
                       ShowInTaskbar="False"
                       Style="{StaticResource ChromeWindowStyle}"
                       WindowStartupLocation="CenterOwner">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Padding="16,11"
                BorderBrush="{StaticResource Line}"
                BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal">
                <controls:Icon VerticalAlignment="Center"
                               Foreground="{StaticResource Ink2}"
                               Geometry="{StaticResource Icon.Search}"
                               Size="16"
                               StrokeThickness="1.9" />
                <TextBox x:Name="QueryBox"
                         MinHeight="28"
                         Margin="10,0,0,0"
                         Padding="0"
                         Background="Transparent"
                         BorderThickness="0"
                         FontSize="15"
                         KeyDown="OnQueryKeyDown"
                         shell:TextBoxAssist.Placeholder="跳转到页面…"
                         Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
        </Border>

        <ListBox x:Name="ResultList"
                 Grid.Row="1"
                 Margin="8,6"
                 ItemContainerStyle="{StaticResource NavItem}"
                 ItemsSource="{Binding Items}"
                 KeyDown="OnListKeyDown"
                 MouseDoubleClick="OnItemActivated"
                 SelectedItem="{Binding SelectedItem, Mode=TwoWay}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <controls:Icon VerticalAlignment="Center"
                                       Foreground="{StaticResource Ink2}"
                                       Geometry="{Binding Icon}"
                                       Size="16"
                                       StrokeThickness="1.85" />
                        <TextBlock Grid.Column="1"
                                   Margin="10,0,0,0"
                                   VerticalAlignment="Center"
                                   Text="{Binding Title}" />
                        <TextBlock Grid.Column="2"
                                   VerticalAlignment="Center"
                                   FontSize="11"
                                   Foreground="{StaticResource Ink3}"
                                   Text="{Binding Hint}" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Border Grid.Row="2"
                Padding="16,8"
                BorderBrush="{StaticResource Line}"
                BorderThickness="0,1,0,0">
            <TextBlock FontSize="11"
                       Foreground="{StaticResource Ink3}"
                       Text="↑↓ 选择 · Enter 打开 · Esc 关闭" />
        </Border>
    </Grid>
</controls:ChromeWindow>