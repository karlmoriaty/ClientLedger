<controls:ChromeWindow x:Class="ClientLedger.Shell.Views.MessageDialog"
                       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                       xmlns:controls="clr-namespace:ClientLedger.Shell.Controls"
                       Title="ClientLedger"
                       Width="440"
                       ResizeMode="NoResize"
                       ShowInTaskbar="False"
                       SizeToContent="Height"
                       Style="{StaticResource ChromeWindowStyle}"
                       WindowStartupLocation="CenterOwner">

    <Grid Margin="24,22,24,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="HeadingText"
                   FontSize="15"
                   FontWeight="SemiBold"
                   TextWrapping="Wrap" />

        <TextBlock x:Name="BodyText"
                   Grid.Row="1"
                   Margin="0,10,0,0"
                   Foreground="{StaticResource Ink1}"
                   LineHeight="21"
                   TextWrapping="Wrap" />

        <StackPanel Grid.Row="2"
                    Margin="0,24,0,0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <Button x:Name="CancelButton"
                    MinWidth="82"
                    Click="OnCancel"
                    Content="取消"
                    Style="{StaticResource SecondaryButton}" />
            <Button x:Name="ConfirmButton"
                    MinWidth="82"
                    Margin="8,0,0,0"
                    Click="OnConfirm"
                    Content="确定"
                    Style="{StaticResource PrimaryButton}" />
        </StackPanel>
    </Grid>
</controls:ChromeWindow>