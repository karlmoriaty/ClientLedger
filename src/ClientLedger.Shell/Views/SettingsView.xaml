<UserControl x:Class="ClientLedger.Shell.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:ClientLedger.Shell.Converters">

    <UserControl.Resources>
        <converters:TokenBrushConverter x:Key="TokenBrush" />
        <converters:TokenSoftBrushConverter x:Key="TokenSoft" />
        <converters:EmptyTextVisibilityConverter x:Key="EmptyText" />
    </UserControl.Resources>

    <Grid Margin="24,18,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Margin="0,0,0,12"
                Padding="12,9"
                Background="{StaticResource AccentSoft}"
                Visibility="{Binding NoticeText, Converter={StaticResource EmptyText}, ConverterParameter=invert}">
            <TextBlock FontSize="12"
                       Foreground="{StaticResource Accent}"
                       Text="{Binding NoticeText}"
                       TextWrapping="Wrap" />
        </Border>

        <TabControl Grid.Row="1">
            <!-- ===== 概览 ===== -->
            <TabItem Header="概览">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Margin="0,0,6,0" Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SectionTitle}" Text="当前身份" />
                                    <TextBlock Margin="0,10,0,0"
                                               FontSize="12.5"
                                               Text="{Binding IdentityText}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Margin="0,4,0,0" Style="{StaticResource Caption}" Text="{Binding ScopeText}" />
                                    <TextBlock Margin="0,4,0,0"
                                               FontSize="11"
                                               Foreground="{StaticResource Ink3}"
                                               Text="身份来自本机 Windows 账户，不需要登录。" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Margin="6,0,0,0" Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SectionTitle}" Text="许可证" />
                                    <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                                        <Border Padding="7,3"
                                                Background="{Binding LicenseTone, Converter={StaticResource TokenSoft}}">
                                            <TextBlock FontSize="11"
                                                       Foreground="{Binding LicenseTone, Converter={StaticResource TokenBrush}}"
                                                       Text="{Binding LicenseStatusText}" />
                                        </Border>
                                        <TextBlock Margin="10,0,0,0"
                                                   VerticalAlignment="Center"
                                                   Style="{StaticResource Caption}"
                                                   Text="{Binding LicenseMessage}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <TextBlock Margin="0,10,0,0" FontSize="11" Foreground="{StaticResource Ink3}">
                                        <Run Text="更新截止：" />
                                        <Run Text="{Binding UpdatesUntilText}" />
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Margin="0,12,0,0" Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitle}" Text="关于" />
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="26" />
                                        <RowDefinition Height="26" />
                                        <RowDefinition Height="26" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Style="{StaticResource Caption}" Text="产品" />
                                    <TextBlock Grid.Column="1" Text="{Binding VersionText}" />
                                    <TextBlock Grid.Row="1" Style="{StaticResource Caption}" Text="作者" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="karlmoriaty" />
                                    <TextBlock Grid.Row="2" Style="{StaticResource Caption}" Text="数据位置" />
                                    <TextBlock Grid.Row="2"
                                               Grid.Column="1"
                                               Style="{StaticResource Mono}"
                                               Text="{Binding DatabasePath}"
                                               TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ===== 权限 ===== -->
            <TabItem Header="权限">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="330" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,18,0">
                        <TextBlock Style="{StaticResource SectionTitle}" Text="角色" />
                        <TextBlock Margin="0,4,0,10"
                                   Style="{StaticResource Caption}"
                                   Text="角色决定导航入口、可执行动作与可见数据范围。"
                                   TextWrapping="Wrap" />

                        <ListBox ItemsSource="{Binding Roles}"
                                 SelectedItem="{Binding SelectedRole, Mode=TwoWay}"
                                 Background="Transparent"
                                 BorderThickness="0">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="{x:Type ListBoxItem}">
                                    <Setter Property="Margin" Value="0,0,0,6" />
                                    <Setter Property="Padding" Value="12,10" />
                                    <Setter Property="Cursor" Value="Hand" />
                                    <Setter Property="Foreground" Value="{StaticResource Ink1}" />
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                                <Border x:Name="Bd"
                                                        Padding="{TemplateBinding Padding}"
                                                        Background="{StaticResource Paper0}"
                                                        BorderBrush="{StaticResource Line}"
                                                        BorderThickness="1">
                                                    <ContentPresenter />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource LineStrong}" />
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSoft}" />
                                                        <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentLine}" />
                                                        <Setter Property="Foreground" Value="{StaticResource Ink0}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock FontSize="12.5" FontWeight="SemiBold" Text="{Binding Name}" />
                                        <TextBlock Margin="0,3,0,0"
                                                   FontSize="11.5"
                                                   Foreground="{StaticResource Ink2}"
                                                   Text="{Binding Description}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <Button Margin="0,8,0,0"
                                HorizontalAlignment="Left"
                                Command="{Binding ApplyRoleCommand}"
                                Content="应用角色"
                                IsEnabled="{Binding CanManageSettings}"
                                Style="{StaticResource PrimaryButton}" />
                    </StackPanel>

                    <Border Grid.Column="1" Style="{StaticResource Card}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top"
                                       Style="{StaticResource SectionTitle}"
                                       Text="当前角色权限" />
                            <ScrollViewer Margin="0,10,0,0" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding PermissionItems}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Height="30">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="230" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock VerticalAlignment="Center"
                                                           Style="{StaticResource Mono}"
                                                           Text="{Binding Token}" />
                                                <TextBlock Grid.Column="1"
                                                           VerticalAlignment="Center"
                                                           Foreground="{StaticResource Ink1}"
                                                           Text="{Binding Label}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ===== 审计 ===== -->
            <TabItem Header="审计">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Margin="0,0,0,10" Orientation="Horizontal">
                        <TextBlock VerticalAlignment="Center" Style="{StaticResource Caption}" Text="{Binding AuditCountText}" />
                        <Button Width="30"
                                Height="30"
                                Margin="8,0,0,0"
                                Command="{Binding RefreshAuditsCommand}"
                                Style="{StaticResource IconButton}"
                                Tag="{StaticResource Icon.Refresh}"
                                ToolTip="刷新审计" />
                    </StackPanel>

                    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
                        <DataGrid IsReadOnly="True" ItemsSource="{Binding Audits}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Width="150"
                                                    Binding="{Binding AtLocalText}"
                                                    Header="时间" />
                                <DataGridTextColumn Width="180"
                                                    Binding="{Binding Action}"
                                                    Header="动作" />
                                <DataGridTextColumn Width="170"
                                                    Binding="{Binding EntityId}"
                                                    Header="对象" />
                                <DataGridTextColumn Width="*"
                                                    Binding="{Binding Summary}"
                                                    Header="摘要" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ===== 许可证 ===== -->
            <TabItem Header="许可证">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitle}" Text="授权信息" />

                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="28" />
                                        <RowDefinition Height="28" />
                                        <RowDefinition Height="28" />
                                        <RowDefinition Height="28" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Style="{StaticResource Caption}" Text="状态" />
                                    <TextBlock Grid.Column="1"
                                               Foreground="{Binding LicenseTone, Converter={StaticResource TokenBrush}}"
                                               Text="{Binding LicenseStatusText}" />

                                    <TextBlock Grid.Row="1" Style="{StaticResource Caption}" Text="许可证号" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource Mono}" Text="{Binding LicenseIdText}" />

                                    <TextBlock Grid.Row="2" Style="{StaticResource Caption}" Text="购买人" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding BuyerText}" />

                                    <TextBlock Grid.Row="3" Style="{StaticResource Caption}" Text="更新截止" />
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding UpdatesUntilText}" />
                                </Grid>

                                <Button Margin="0,16,0,0"
                                        HorizontalAlignment="Left"
                                        Command="{Binding ImportLicenseCommand}"
                                        Content="导入许可证…"
                                        IsEnabled="{Binding CanManageLicense}"
                                        Style="{StaticResource PrimaryButton}" />
                            </StackPanel>
                        </Border>

                        <Border Margin="0,12,0,0" Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitle}" Text="买断规则" />
                                <TextBlock Margin="0,8,0,0"
                                           Foreground="{StaticResource Ink1}"
                                           LineHeight="21"
                                           TextWrapping="Wrap">
                                    <Run Text="买断指当前版本永久可用，不按年收费。" />
                                    <Run Text="更新截止日之后仍可继续使用已安装的版本，只是不再获得新版本。" />
                                    <Run Text="许可证离线校验，不需要联网，也不会向任何服务器发送数据。" />
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ===== 数据 ===== -->
            <TabItem Header="数据">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitle}" Text="数据文件" />
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="26" />
                                        <RowDefinition Height="26" />
                                        <RowDefinition Height="26" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Style="{StaticResource Caption}" Text="数据库" />
                                    <TextBlock Grid.Column="1" Style="{StaticResource Mono}" Text="{Binding DatabasePath}" TextTrimming="CharacterEllipsis" />

                                    <TextBlock Grid.Row="1" Style="{StaticResource Caption}" Text="备份目录" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource Mono}" Text="{Binding BackupPath}" TextTrimming="CharacterEllipsis" />

                                    <TextBlock Grid.Row="2" Style="{StaticResource Caption}" Text="日志目录" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource Mono}" Text="{Binding LogPath}" TextTrimming="CharacterEllipsis" />
                                </Grid>

                                <StackPanel Margin="0,14,0,0" Orientation="Horizontal">
                                    <Button Command="{Binding BackupCommand}"
                                            Content="立即备份"
                                            Style="{StaticResource SecondaryButton}" />
                                    <Button Margin="8,0,0,0"
                                            Command="{Binding OpenDataFolderCommand}"
                                            Content="打开数据目录"
                                            Style="{StaticResource SecondaryButton}" />
                                    <Button Margin="8,0,0,0"
                                            Command="{Binding OpenLogFolderCommand}"
                                            Content="打开日志目录"
                                            Style="{StaticResource SecondaryButton}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Margin="0,12,0,0" Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitle}" Text="示例数据" />
                                <TextBlock Margin="0,6,0,12"
                                           Foreground="{StaticResource Ink1}"
                                           TextWrapping="Wrap"
                                           Text="首次启动会写入带示例标记的客户、联系人、跟进、日程与报价，方便快速了解界面。清除操作只删除这些示例记录。" />
                                <Button HorizontalAlignment="Left"
                                        Command="{Binding ClearDemoCommand}"
                                        Content="清除示例数据"
                                        IsEnabled="{Binding CanResetData}"
                                        Style="{StaticResource DangerButton}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>